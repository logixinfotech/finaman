# ── Production build settings (npm run build) ─────────────────────────────
# Both values are intentionally EMPTY.
#
# With no host and no port configured, src/config.js falls back to relative
# URLs (/api/..., /uploads/...), so the app talks to whatever origin served
# it. FinamanAPI.exe serves finaman-erp\build on its own port, which means
# ONE build works at every client — 122.160.143.110, 165.99.210.94, a LAN
# IP or a domain — with no rebuild and nothing to edit.
#
# Only fill these in for a client whose frontend is hosted separately from

# the API (IIS/Nginx on another host or port), and rebuild for that client.
#REACT_APP_API_URL=http://122.160.143.110:63554

REACT_APP_API_URL=
REACT_APP_API_PORT=


