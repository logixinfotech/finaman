# ── Development settings (npm start) ──────────────────────────────────────
# Committed on purpose, so a fresh clone works without anyone creating a
# local .env by hand.
#
# The dev server serves the page on :3000 while the API runs on :63554, so
# the API port must be stated. The HOSTNAME is taken from whatever address
# you opened the page on — localhost, your LAN IP, or a public IP all work
# with no change here.
REACT_APP_API_PORT=63554

# Only if the API runs on a DIFFERENT HOST from your dev machine:
# REACT_APP_API_URL=http://192.168.1.42:63554
